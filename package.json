{
  "name": "campushub",
  "version": "4.0.0",
  "private": true,
  "description": "CampusHub: Angular, React, Vue y Next.js sobre una API compartida",
  "workspaces": [
    "core-js",
    "api-mock",
    "angular-admin",
    "react-estudiante",
    "vue-kiosko",
    "next-publico"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "api": "npm run api --workspace api-mock",
    "admin": "npm run start --workspace angular-admin",
    "sync-core": "node scripts/sync-core.mjs && node scripts/sync-react.mjs",
    "test": "npm run test --workspace core-js",
    "build": "npm run build:angular && npm run build:react && npm run build:vue && npm run build:next",
    "verificar": "npm test && npm run revisar:componentes && npm run build",
    "restaurar-datos": "node scripts/restaurar-datos.mjs",
    "estudiante": "npm run start --workspace react-estudiante",
    "sync-react": "node scripts/sync-react.mjs",
    "kiosko": "npm run start --workspace vue-kiosko",
    "publico": "npm run start --workspace next-publico",
    "build:vue": "npm run build --workspace vue-kiosko",
    "build:next": "npm run build --workspace next-publico",
    "build:angular": "npm run build --workspace angular-admin",
    "build:react": "npm run build --workspace react-estudiante",
    "revisar:componentes": "node scripts/revisar-componentes.mjs"
  },
  "devDependencies": {}
}
